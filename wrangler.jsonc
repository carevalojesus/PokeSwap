{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokeswap-classroom",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}
